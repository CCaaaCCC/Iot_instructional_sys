PROJECT_NAME=Smart Greenhouse Admin API
API_V1_STR=/api/v1
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/greenhouse?charset=utf8mb4
JWT_SECRET_KEY=please_change_me_to_a_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*
LOG_LEVEL=INFO
AUTO_CREATE_DB=true
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin123456
INIT_SAMPLE_DATA=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=greenhouse-backend
MQTT_TOPIC_SENSOR_DATA=greenhouse/sensor/data
MQTT_TOPIC_DEVICE_STATUS=greenhouse/device/status
MQTT_TOPIC_DEVICE_CONTROL=greenhouse/device/control
# AI / DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_REASONER=deepseek-reasoner
AI_DAILY_QUOTA=50
AI_CONTEXT_WINDOW=10
AI_SESSION_TITLE_MAXLEN=30
AI_REQUEST_TIMEOUT=60
# MCP Bridge (小智 AI)
# MCP_ENDPOINT: 从 xiaozhi.me 控制台获取的完整 WebSocket 接入点 URL
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/your-endpoint
# DEVICE_TOKEN: 从后台 /device-tokens 获取 esp32s3 类型的 token
DEVICE_TOKEN=your-esp32s3-device-token
LOCAL_API_BASE=http://127.0.0.1:8001
