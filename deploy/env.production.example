# 智慧大棚教学平台 - 生产环境变量模板
# install.sh 会在项目根目录生成/更新 .env，并自动填充下列关键项：
#   DATABASE_URL / JWT_SECRET_KEY / INIT_ADMIN_PASSWORD / CORS_ORIGINS / MQTT_BROKER_HOST
# 其余密钥（DeepSeek / MCP）请手动填写。

PROJECT_NAME=Smart Greenhouse Admin API
API_V1_STR=/api/v1

# 由安装脚本写入
DATABASE_URL=mysql+pymysql://greenhouse:CHANGE_ME@127.0.0.1:3306/greenhouse?charset=utf8mb4
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://CHANGE_ME
LOG_LEVEL=INFO
AUTO_CREATE_DB=true
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=CHANGE_ME
INIT_SAMPLE_DATA=false

# MQTT（与后端同机）
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=greenhouse-backend
MQTT_TOPIC_SENSOR_DATA=greenhouse/sensor/data
MQTT_TOPIC_DEVICE_STATUS=greenhouse/device/status
MQTT_TOPIC_DEVICE_CONTROL=greenhouse/device/control

# DeepSeek AI 助手（留空则 AI 功能返回未配置错误）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_REASONER=deepseek-reasoner
AI_DAILY_QUOTA=50
AI_CONTEXT_WINDOW=10
AI_SESSION_TITLE_MAXLEN=30
AI_REQUEST_TIMEOUT=60

# 小智 AI MCP 桥接（不需要可留空，install.sh 会跳过该服务）
MCP_ENDPOINT=
DEVICE_TOKEN=
LOCAL_API_BASE=http://127.0.0.1:8001
